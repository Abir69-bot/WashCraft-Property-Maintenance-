# Copy to .env and fill in. Every variable is validated in src/lib/env.ts.
# Only DATABASE_URI and PAYLOAD_SECRET are required; every integration added in later
# phases is optional and falls back to console logging when its variables are blank.

# ── Database: Neon serverless Postgres (README → "Neon setup") ───────────────────────
# Pooled string (host contains "-pooler"). Used by the running app.
# Local dev: the `dev` branch. Vercel production: the `production` branch.
# The Vercel–Neon integration's DATABASE_URL is accepted as a fallback name.
DATABASE_URI=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require

# Direct string (no "-pooler"). Used only by `pnpm db:migrate` and backups (pg_dump).
# Falls back to DATABASE_URI when blank. DATABASE_URL_UNPOOLED is accepted as a fallback name.
DATABASE_URI_DIRECT=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require

# Storage warning threshold for the admin database-size widget (Neon free plan: 512 MB).
DB_STORAGE_LIMIT_MB=512

# ── Payload CMS ───────────────────────────────────────────────────────────────────────
# Random string, 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PAYLOAD_SECRET=

# ── Site ──────────────────────────────────────────────────────────────────────────────
# Public URL without a trailing slash. Used for canonical URLs, sitemaps and admin links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional override for the deploy environment: development | preview | production.
# Normally derived from VERCEL_ENV / NODE_ENV. Production hides sample content and allows
# indexing; development and preview show "Sample" badges and send noindex.
SITE_ENV=

# Set to true to make `pnpm check-config` fail on unset business facts outside Vercel
# production builds (where it is always strict).
STRICT_CONFIG=

# ── Tests ─────────────────────────────────────────────────────────────────────────────
# Database for `pnpm test:int`. Never point this at the Neon production branch.
# Default: the Docker Postgres from `pnpm test:db:up`.
TEST_DATABASE_URI=postgresql://postgres:postgres@127.0.0.1:5433/washcraft_test
