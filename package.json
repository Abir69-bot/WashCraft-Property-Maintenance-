{
  "name": "washcraft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "test:db:up": "docker compose up -d --wait db",
    "test:db:down": "docker compose down",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "db:migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "db:migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "db:migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "check-config": "tsx scripts/check-config.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "graphql": "16.14.2",
    "lucide-react": "1.60.0",
    "next": "16.4.2",
    "payload": "3.91.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/env": "16.4.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
